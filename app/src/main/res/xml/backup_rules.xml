<?xml version="1.0" encoding="utf-8"?>
<!--
    Per TZ §7 — site cookies / tokens / history MUST NOT be backed up.
    Only user-curated prompts (Compose state stored in DataStore) are eligible.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="."/>
</full-backup-content>
